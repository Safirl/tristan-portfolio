---
import { getCollection } from "astro:content";
import Card from "../components/Card.astro";
let projects = await getCollection("projects", ({ data }) => {
    return data.published;
});
---

<canvas id="three" data-projects={JSON.stringify(projects)}></canvas>
<!-- {projects.map((item) => <Card project={item} />)} -->

<style lang="scss">
    #three {
        width: 100%;
        height: 100%;
        position: absolute;
    }
</style>

<script>
    import {
        Experience,
        OrbitCamera,
        TemplateWorld,
    } from "@plugins/three-base-experience";
    import sources from "../three/sources";
    import ExpWorld from "../three/World";
    import ExpCamera from "../three/Camera";

    const canvas = document.getElementById("three") as HTMLCanvasElement;

    if (!canvas) {
        throw new Error(
            "Canvas element is not valid, can't instantiate experience.",
        );
    }

    const camera = new OrbitCamera();
    const projects = JSON.parse(canvas.dataset.projects ?? "{}");
    const world = new ExpWorld(projects);
    const experience = new Experience(canvas, sources, camera, world);
    experience.init();
</script>
