{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    // "strictNullChecks": true,
    // "allowJs": true,
    "paths": {
      "@plugins/*": ["./src/plugins/*"],
      "@shaders/*": ["./src/shaders/*"],
    }
  },
}
